<%- include("../partials/header") %>

<main>
  <section class="faculty-header">
    <h1><%= facultyMember.name %></h1>
    <p class="faculty-title"><%= facultyMember.title %></p>
    <p class="faculty-department"><%= facultyMember.department %> Department</p>
  </section>

  <section class="faculty-details">
    <article class="detail-section">
      <h2>Contact Information</h2>

      <p class="detail-item">
        <strong>Office:</strong> <%= facultyMember.office %>
      </p>

      <p class="detail-item">
        <strong>Phone:</strong>
        <a href="tel:<%= facultyMember.phone %>"><%= facultyMember.phone %></a>
      </p>

      <p class="detail-item">
        <strong>Email:</strong>
        <a href="mailto:<%= facultyMember.email %>"><%= facultyMember.email %></a>
      </p>

      <p class="detail-item">
        <strong>Department:</strong> <%= facultyMember.department %>
      </p>

      <p class="detail-item">
        <strong>Title:</strong> <%= facultyMember.title %>
      </p>
    </article>

    <p>
      <a href="/faculty">&larr; Back to Faculty Directory</a>
    </p>
  </section>
</main>

<%- include("../partials/footer") %>